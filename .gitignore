# ===================================================================
# Glow Beauty data warehouse - .gitignore
#
# Rule of thumb: if a file can be REGENERATED by running something in
# this repo, it does not belong in git. If it is source, it does.
# ===================================================================


# -------------------------------------------------------------------
# SQL*Loader output
# Regenerated on every load_all.bat run, into
#   operational_DB\sqlloader_control_files\   (logs)
#   sales_data\data*\                         (.bad / .dsc)
# Logs are named <table>_<folder>.log e.g. branch_data2.log
# -------------------------------------------------------------------
*.log
*.bad
*.dsc


# -------------------------------------------------------------------
# Generated SQL
# holiday_update.sql is produced by gen_holidays.py:
#     python gen_holidays.py 2019 2025 > holiday_update.sql
# The generator is source; its output is not.
# -------------------------------------------------------------------
holiday_update*.sql


# -------------------------------------------------------------------
# Python
# -------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/


# -------------------------------------------------------------------
# Oracle / SQL Developer scratch
# -------------------------------------------------------------------
*.trc
*.trm
sqlnet.log
afiedt.buf
.sqldeveloper/


# -------------------------------------------------------------------
# Editors and OS
# -------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store


# -------------------------------------------------------------------
# Credentials - never commit a password
# The load scripts take it as a command-line argument, so nothing
# should ever land here, but the guard costs nothing.
# -------------------------------------------------------------------
*.env
.env
tnsnames.ora
credentials*.txt


# ===================================================================
# DELIBERATELY TRACKED
# ===================================================================
# sales_data\data\  data2\  data3\      ~65 MB of CSVs
#
#   data\  is the supplied source dataset - it cannot be regenerated,
#   so it must stay in git.
#
#   data2\ and data3\ CAN be regenerated (gen_data2.py / gen_data3.py
#   are seeded, so the output is identical every run). They are kept
#   anyway because they are part of the deliverable and the loader
#   needs them present. To drop them from the repo later, uncomment:
#
# sales_data/data2/*.csv
# sales_data/data3/*.csv


# ===================================================================
# NOTE: .gitignore does not untrack a file that is already committed.
# If a generated file ever shows up as tracked again, stop tracking it
# (without deleting it from disk) with:
#   git rm --cached <path>
# ===================================================================
